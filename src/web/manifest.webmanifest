{
  "name": "GlossCode",
  "short_name": "GlossCode",
  "description": "G-code editor that shows a plain-English gloss above every line of code, checks the program and simulates the toolpath.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f3f4f6",
  "theme_color": "#f3f4f6",
  "icons": [
    { "src": "icons/glosscode-128.png", "sizes": "128x128", "type": "image/png" },
    { "src": "icons/glosscode-256.png", "sizes": "256x256", "type": "image/png" },
    { "src": "icons/glosscode-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/glosscode.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": { "text/plain": [".nc", ".ngc", ".tap", ".gcode", ".cnc", ".min", ".ssb", ".eia", ".mpf", ".spf"] }
    }
  ],
  "launch_handler": { "client_mode": "focus-existing" }
}
