  "cycleHelp": {
    "okuma.lathe": {
      "G71": { "sketch": "thread", "about": "Cuts a whole thread along Z in one block: passes get shallower until the thread height H is reached, then an optional finishing pass removes U.", "words": { "X": ["28.", "Final thread diameter."], "Z": ["5.", "Z where the thread ends."], "D": ["0.5", "Depth of the first pass, as a diameter.", "CUT1"], "H": ["1.8", "Thread height, as a diameter.", "THDHT"], "F": ["1.5", "Thread lead.", "LEAD"], "B": ["60", "Infeed angle, usually the insert's point angle (0 if left out).", "INFEED"], "A": ["30", "Taper angle (use A or the taper word, not both).", "TAPER"], "U": ["0.1", "Finishing allowance, as a diameter. No finishing pass without it.", "ALLOW"], "L": ["1.5", "Chamfer length on the last pass (with M23 on).", "CHAMF"], "E": ["0.2", "Lead change per lead, for a variable-lead thread.", "LEADCHG"], "J": ["1", "Number of threads within the F distance (1 if left out).", "THDS"], "M": ["32", "Picks the infeed mode and pattern (M32 to M34, M73 to M75)."], "Q": ["2", "Number of starts for a multi-start thread.", "STARTS"], "I": ["7.", "Taper as a difference in radius from start to end.", "TAPERR"] } },
      "G72": { "sketch": "thread", "about": "Like G71, but the thread is cut on the face, along X.", "words": { "X": ["28.", "Final thread diameter."], "Z": ["5.", "Z where the thread ends."], "D": ["0.5", "Depth of the first pass, as a diameter.", "CUT1"], "H": ["1.8", "Thread height, as a diameter.", "THDHT"], "F": ["1.5", "Thread lead.", "LEAD"], "B": ["60", "Infeed angle, usually the insert's point angle (0 if left out).", "INFEED"], "A": ["30", "Taper angle (use A or the taper word, not both).", "TAPER"], "U": ["0.1", "Finishing allowance, as a diameter. No finishing pass without it.", "ALLOW"], "L": ["1.5", "Chamfer length on the last pass (with M23 on).", "CHAMF"], "E": ["0.2", "Lead change per lead, for a variable-lead thread.", "LEADCHG"], "J": ["1", "Number of threads within the F distance (1 if left out).", "THDS"], "M": ["32", "Picks the infeed mode and pattern (M32 to M34, M73 to M75)."], "Q": ["2", "Number of starts for a multi-start thread.", "STARTS"], "K": ["7.", "Taper as a difference from start to end along Z.", "TAPERZ"] } },
      "G73": { "sketch": "groove", "about": "Grooves along Z: plunges in steps of D to X, shifting by I and K between plunges, with an optional dwell at the bottom.", "words": { "X": ["20.", "X of the groove bottom."], "Z": ["-10.", "Z of the target point."], "D": ["2.", "Depth of each plunge.", "PLUNGE"], "I": ["0", "Shift along X between plunges, as a diameter.", "SHIFTX"], "K": ["3.", "Shift along Z between plunges.", "SHIFTZ"], "L": ["4.", "Infeed after which the tool backs out to clear chips.", "CLEARAT"], "F": ["0.1", "Feed."], "E": ["0.5", "Dwell at the bottom, in the same units as a G04 F.", "DWELL"], "T": ["0303", "Tool offset to use at the target point.", "TOFS"] } },
      "G74": { "sketch": "face-groove", "about": "Grooves or drills on the face: pecks in steps of D toward Z, shifting by I and K between pecks, with an optional dwell at the bottom.", "words": { "X": ["0", "X of the target point."], "Z": ["-20.", "Z of the bottom."], "D": ["3.", "Depth of each peck.", "PECK"], "I": ["0", "Shift along X between pecks, as a diameter.", "SHIFTX"], "K": ["0", "Shift along Z between pecks.", "SHIFTZ"], "L": ["10.", "Infeed after which the tool backs out to clear chips.", "CLEARAT"], "F": ["0.1", "Feed."], "E": ["0.5", "Dwell at the bottom, in the same units as a G04 F.", "DWELL"], "T": ["0303", "Tool offset to use at the target point.", "TOFS"] } },
      "G77": { "sketch": "tap", "about": "Right-hand tapping on center: starts the spindle forward at the speed already set, rapids to K, taps to Z, reverses out. The spindle is left stopped afterwards.", "words": { "X": ["0", "X of the tap (on center)."], "Z": ["-20.", "Z of the tap bottom."], "K": ["5.", "Z where the rapid approach stops and tapping starts.", "APPRZ"], "F": ["1.25", "Feed, equal to the tap pitch under G95."] } },
      "G78": { "sketch": "tap", "about": "Like G77 for a left-hand tap: the spindle runs in reverse going in. The spindle is left stopped afterwards.", "words": { "X": ["0", "X of the tap (on center)."], "Z": ["-20.", "Z of the tap bottom."], "K": ["5.", "Z where the rapid approach stops and tapping starts.", "APPRZ"], "F": ["1.25", "Feed, equal to the tap pitch under G95."] } }
    }
