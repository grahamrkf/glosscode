  "cycleHelp": {
    "linuxcnc.lathe": {
      "G76": { "sketch": "thread", "about": "Cuts a whole thread in one line. Passes get shallower until the full depth K is reached. All the words are distances as written; there are no packed digit codes.", "labels": { "height": "K", "first": "J" }, "words": { "P": ["0.0625", "Thread pitch: the distance per turn.", "PITCH"], "Z": ["-1.", "Where the thread ends."], "I": ["-0.01", "Thread peak offset from the start X. Negative for an outside thread.", "PEAK"], "J": ["0.005", "Depth of the first cut.", "CUT1"], "K": ["0.04", "Full thread depth.", "THDDEPTH"], "R": ["1.5", "Depth degression: how fast the cuts get shallower.", "DEGRESS"], "Q": ["29.5", "Compound slide angle, in degrees.", "COMPOUND"], "H": ["1", "Number of spring passes.", "SPRING"], "E": ["0.05", "Taper distance at each end.", "TAPERLEN"], "L": ["3", "Which ends get the taper: 0 none, 1 entry, 2 exit, 3 both.", "TAPEREND"] } },
      "G70": { "sketch": "finish", "about": "Finishes the profile in an O-subroutine named by Q, after roughing with G71 or G72.", "words": { "Q": ["100", "The O-subroutine that holds the profile.", "PROFILE"], "X": ["1.", "Start X (the current X if left out)."], "Z": ["0.1", "Start Z (the current Z if left out)."], "D": ["0", "Starting offset from the profile.", "OFFSET"], "E": ["0", "Finishing pass offset.", "FINOFS"], "P": ["1", "Number of finishing passes.", "PASSES"] } },
      "G71": { "sketch": "rough", "about": "Roughs along Z to the profile in an O-subroutine named by Q, leaving D for finishing.", "words": { "Q": ["100", "The O-subroutine that holds the profile.", "PROFILE"], "X": ["1.", "Start X (the current X if left out)."], "Z": ["0.1", "Start Z (the current Z if left out)."], "D": ["0.01", "Finishing allowance left on the profile.", "ALLOW"], "I": ["0.05", "Depth of each roughing pass.", "CUTDEPTH"], "R": ["0.01", "Retract distance after each pass.", "RETRACT"] } },
      "G72": { "sketch": "face-rough", "about": "Like G71, but roughs on the face, along X.", "words": { "Q": ["100", "The O-subroutine that holds the profile.", "PROFILE"], "X": ["1.", "Start X (the current X if left out)."], "Z": ["0.1", "Start Z (the current Z if left out)."], "D": ["0.01", "Finishing allowance left on the profile.", "ALLOW"], "I": ["0.05", "Depth of each roughing pass.", "CUTDEPTH"], "R": ["0.01", "Retract distance after each pass.", "RETRACT"] } }
