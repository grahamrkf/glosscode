  "cycleHelp": {
    "haas.mill": {
      "common": { "words": {
        "I": ["0.2", "First peck depth (use I, J and K instead of Q).", "PECK1"],
        "J": ["0.02", "How much shorter each peck gets.", "PECKLESS"],
        "K": ["0.05", "Shortest peck allowed.", "PECKMIN"]
      } },
      "G74": { "words": { "J": ["2", "Retract speed: J2 comes out twice as fast as it went in.", "RETSPD"] } },
      "G84": { "words": { "J": ["2", "Retract speed: J2 comes out twice as fast as it went in.", "RETSPD"] } },
      "G76": { "words": { "I": ["0.01", "Shift along X before pulling out (instead of Q).", "SHIFTX"], "J": ["0", "Shift along Y before pulling out (instead of Q).", "SHIFTY"], "Q": ["0.01", "How far the tool moves off the wall before it pulls out.", "SHIFT"] } },
      "G77": { "sketch": "backbore", "about": "Back boring. The tool goes down through the hole shifted off center, moves back to center, starts the spindle and cuts upward to Z.",
        "labels": { "shift": "Q" },
        "words": { "Z": ["-0.75", "Top of the back bore (where the upward cut stops)."], "R": ["-1.1", "Start of the cut, below the part."], "Q": ["0.05", "How far the tool is shifted to pass through the hole.", "SHIFT"],
          "I": ["0.05", "Shift along X (instead of Q).", "SHIFTX"], "J": ["0", "Shift along Y (instead of Q).", "SHIFTY"] } }
    },

    "haas.lathe": {
      "G71": { "about": "Roughs away the stock down to the contour between lines P and Q, in passes along Z of depth D, and leaves U and W for G70 to finish. Haas does it in one line.",
        "labels": { "depth": "D" },
        "words": { "D": ["0.1", "Depth of each roughing pass, as a radius.", "DEPTH"], "I": ["0.01", "Rough stock left on X, as a radius.", "RUFX"], "K": ["0.005", "Rough stock left on Z.", "RUFZ"], "T": ["0101", "Tool and offset for the cycle."], "R": ["1", "R1 turns on Type II roughing for pockets in the profile.", "TYPE"] } },
      "G72": { "about": "Like G71, but the passes run along X, facing down from the end of the part. Haas does it in one line.",
        "labels": { "depth": "D" },
        "words": { "D": ["0.05", "Depth of each roughing pass.", "DEPTH"], "I": ["0.01", "Rough stock left on X, as a radius.", "RUFX"], "K": ["0.005", "Rough stock left on Z.", "RUFZ"], "T": ["0101", "Tool and offset for the cycle."] } },
      "G73": { "sketch": "path-rough", "about": "Roughs by repeating the contour itself, shifted outward and stepping in each pass. Good for castings and forgings that already have roughly the right shape.",
        "words": { "U": ["0.02", "Finish stock left on X for G70, as a diameter.", "ALLOWX"], "W": ["0.005", "Finish stock left on Z for G70.", "ALLOWZ"], "P": ["100", "N number of the first line of the contour."], "Q": ["200", "N number of the last line of the contour."], "I": ["0.2", "Stock to remove on X, as a radius.", "STOCKX"], "K": ["0.1", "Stock to remove on Z.", "STOCKZ"], "D": ["3", "Number of passes.", "PASSES"], "F": ["0.01", "Roughing feed."], "T": ["0101", "Tool and offset for the cycle."] } },
      "G74": { "sketch": "face-groove", "about": "Pecks along Z into the face, for face grooves or drilling on center. With X and I it steps outward and pecks again.",
        "words": { "Z": ["-0.25", "Depth of the groove or hole."], "X": ["1.5", "Outer diameter to step out to."], "K": ["0.05", "Peck depth in Z.", "PECK"], "I": ["0.1", "Step in X between pecking passes, as a radius.", "STEPX"], "D": ["0.", "Clearance when stepping back out.", "CLEAR"], "F": ["0.004", "Feed."] } },
      "G75": { "sketch": "groove", "about": "Pecks in along X for an OD or ID groove. With Z and K it steps along and pecks again to make a wide groove.",
        "words": { "X": ["0.9", "Diameter at the bottom of the groove."], "Z": ["-0.75", "Z where the last groove pass is."], "I": ["0.05", "Peck depth in X, as a radius.", "PECK"], "K": ["0.1", "Step in Z between grooves.", "STEPZ"], "D": ["0.", "Clearance when stepping back out.", "CLEAR"], "F": ["0.003", "Feed."] } },
      "G76": { "about": "Cuts a whole thread in many passes. Each pass feeds in along the flank and takes a little less than the last, so the chip load stays even. Haas does it in one line.",
        "labels": { "height": "K", "first": "D" },
        "words": { "K": ["0.0383", "Thread height, as a radius.", "THDHT"], "D": ["0.012", "Depth of the first pass. Later passes get shallower to keep the chip load even.", "DEPTH"],
          "A": ["60", "Tool tip angle, 0 to 120 degrees, no decimal point. The tool feeds in along the flank at half this angle.", "ANGLE"],
          "I": ["0.", "Taper, as a radius. 0 for a straight thread.", "TAPER"],
          "P": ["1", "How each pass cuts: P1 one edge, even amount (default); P2 both edges, even amount; P3 one edge, even depth; P4 both edges, even depth.", "METHOD"],
          "Q": ["0", "Start angle for multi-start threads, in 0.001 degree with no decimal point (Q180000 is 180 degrees).", "START"] } },
      "G81": { "sketch": "drill", "about": "Drills on the part's centerline while the spindle turns the part: rapid to R, feed to Z, rapid back out. Off-center holes need live tooling and C.",
        "words": { "Z": ["-0.5", "Bottom of the hole."], "R": ["0.1", "Z position where the feed starts. The tool rapids to R first."], "X": ["0.", "Hole position as a diameter. X0. is on center; off center needs live tooling and C."], "C": ["90.", "Spindle angle for an off-center hole (live tooling with a C axis).", "ANGLEC"], "Y": ["0.", "Y position, on lathes with a Y axis."], "W": ["-0.6", "Incremental Z distance to the bottom, used instead of Z."], "F": ["0.004", "Feed per rev."] } },
      "G82": { "sketch": "dwell", "about": "Like G81, but it pauses at the bottom for P, for a spot drill or a flat-bottom hole.",
        "words": { "Z": ["-0.5", "Bottom of the hole."], "R": ["0.1", "Z position where the feed starts. The tool rapids to R first."], "X": ["0.", "Hole position as a diameter. X0. is on center; off center needs live tooling and C."], "C": ["90.", "Spindle angle for an off-center hole (live tooling with a C axis).", "ANGLEC"], "Y": ["0.", "Y position, on lathes with a Y axis."], "W": ["-0.6", "Incremental Z distance to the bottom, used instead of Z."], "F": ["0.004", "Feed per rev."], "P": ["0.5", "Dwell at the bottom, in seconds."] } },
      "G83": { "sketch": "peck", "about": "Peck drills on center, coming back out to R after each peck of Q to clear the chips. I, J and K give shrinking pecks instead of Q.",
        "words": { "Z": ["-0.5", "Bottom of the hole."], "R": ["0.1", "Z position where the feed starts. The tool rapids to R first."], "X": ["0.", "Hole position as a diameter. X0. is on center; off center needs live tooling and C."], "C": ["90.", "Spindle angle for an off-center hole (live tooling with a C axis).", "ANGLEC"], "Y": ["0.", "Y position, on lathes with a Y axis."], "W": ["-0.6", "Incremental Z distance to the bottom, used instead of Z."], "F": ["0.004", "Feed per rev."], "Q": ["0.1", "Depth of each peck.", "PECK"], "I": ["0.15", "First peck depth (use I, J and K instead of Q).", "PECK1"], "J": ["0.02", "How much shorter each peck gets.", "PECKLESS"], "K": ["0.05", "Shortest peck allowed.", "PECKMIN"], "P": ["0.", "Dwell at the bottom, in seconds."] } },
      "G84": { "sketch": "tap", "about": "Taps on center. Under G99 (feed per rev) F is the thread pitch: a 1/4-20 tap is F0.05.",
        "words": { "Z": ["-0.5", "Bottom of the hole."], "R": ["0.1", "Z position where the feed starts. The tool rapids to R first."], "X": ["0.", "Hole position as a diameter. X0. is on center; off center needs live tooling and C."], "C": ["90.", "Spindle angle for an off-center hole (live tooling with a C axis).", "ANGLEC"], "Y": ["0.", "Y position, on lathes with a Y axis."], "W": ["-0.6", "Incremental Z distance to the bottom, used instead of Z."], "F": ["0.05", "Feed per rev, equal to the thread pitch."], "Q": ["0.1", "Peck depth, for pecking taps. Each peck is this much deeper.", "PECK"] } },
      "G184": { "sketch": "tap", "about": "Taps a left-hand thread on center. Starts the spindle in reverse by itself. Under G99 (feed per rev) F is the thread pitch. Give S before the cycle.",
        "words": { "Z": ["-0.5", "Bottom of the hole."], "R": ["0.1", "Z position where the feed starts. The tool rapids to R first."], "X": ["0.", "Hole position as a diameter."], "W": ["-0.6", "Incremental Z distance to the bottom, used instead of Z."], "F": ["0.05", "Feed per rev, equal to the thread pitch."], "Q": ["0.1", "Peck depth, for pecking taps.", "PECK"] } },
      "G241": { "sketch": "drill", "labels": { "axis": "X", "Z": "X" }, "about": "Drills in toward the centerline with a live tool, from diameter R down to diameter X. Z and C place the hole. Needs live tooling.",
        "words": { "X": ["0.75", "Bottom of the radial hole, as a diameter."], "R": ["2.1", "Diameter where the feed starts. The tool rapids to R first."], "Z": ["-0.5", "Z position of the hole along the part."], "C": ["0.", "Spindle angle of the hole.", "ANGLEC"], "Y": ["0.", "Y position, on lathes with a Y axis."], "F": ["3.", "Feed per minute (live tools usually run under G98)."] } },
      "G243": { "sketch": "peck", "labels": { "axis": "X", "Z": "X" }, "about": "Peck drills in toward the centerline with a live tool, backing out to R after each peck of Q. Needs live tooling.",
        "words": { "X": ["0.75", "Bottom of the radial hole, as a diameter."], "R": ["2.1", "Diameter where the feed starts. The tool rapids to R first."], "Z": ["-0.5", "Z position of the hole along the part."], "C": ["0.", "Spindle angle of the hole.", "ANGLEC"], "Y": ["0.", "Y position, on lathes with a Y axis."], "F": ["3.", "Feed per minute (live tools usually run under G98)."], "Q": ["0.1", "Depth of each peck.", "PECK"], "I": ["0.15", "First peck depth (use I, J and K instead of Q).", "PECK1"], "J": ["0.02", "How much shorter each peck gets.", "PECKLESS"], "K": ["0.05", "Shortest peck allowed.", "PECKMIN"], "P": ["0.", "Dwell at the bottom, in seconds."] } }
    }
  }
