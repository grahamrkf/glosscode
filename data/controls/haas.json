      "foreign": { "M97": null, "M88": null, "M89": null },
      "engrave": { "code": "G47", "charWidth": 1.0, "charHeight": 1.0, "verified": false,
                   "note": "G47 P0/P1 text engraving: J is the character height and X Y the start. Letter widths vary and aren't given, so the simulation draws each line of text as one rectangle charHeight x J tall and an estimated charWidth x J per character long, open on the right. J is the height of the path the tool centre follows, so the cut letters are taller by the tool width: around the rectangle a lighter edge half the tool diameter wide shows what is cut, when the tool line's comment gives the diameter (1/16, .0625, 1.5MM). A shop note in proven programs says J.120 text comes out .150 high (J plus a .030 tool) and .120 wide per character. A P1 serial number that carries on along the same baseline sets where the text before it ends." },
      "rotate": { "center": ["A", "B"], "setting": "Setting 72",
                  "note": "Haas G68 A B R: A and B are the center (the current position when they're left out), R the angle in degrees. With no R the angle comes from Setting 72: the simulation leaves the toolpath unturned and says so." },
      "mirror": { "on": "G101", "off": "G100", "about": "zero",
                  "note": "G101 X0 Y0 mirrors the axes named about work zero (the values aren't used). G100 with axes turns those off; G100 alone turns all off." },
      "boltPatterns": { "G70": "circle", "G71": "arc", "G72": "line", "verified": false,
                        "note": "Bolt hole patterns drilled with the active canned cycle, about the current position (or X Y on the line). G70 I radius (minus: clockwise), J start angle, L holes evenly round a circle. G71 I radius, J start angle, K angle between holes, L holes. G72 I distance between holes, J angle, L holes in a line; the start position isn't drilled." },
      "circlePockets": { "G12": "cw", "G13": "ccw", "verified": false,
                         "note": "G12 (clockwise) and G13 (counterclockwise) circular pocket from the current position: I first radius, K finished radius, Q step out, Z depth, L repeats (G91 Z each time), D the cutter comp offset. Drawn as full circles at each radius; the tool centre is inside them, by the cutter radius." },
      "cylMap": { "code": "G107", "diameter": "Q", "setting": "Setting 34", "verified": false,
                  "note": "G107 A0 Y0 Q wraps Y onto the A axis: Y distances go round a cylinder Q across (Q0: the diameter in Setting 34). G107 alone turns it off. The simulation draws the Y moves unrolled, in a rectangle one turn tall." },
      "codeWords": {
        "G70": { "name": "Bolt hole circle", "needsCycle": true, "need": [{ "of": ["I"], "count": 1 }, { "of": ["L"], "count": 1 }],
                 "words": { "I": ["RAD", "Bolt circle radius (minus: the holes go clockwise)"], "J": ["STARTANG", "Angle of the first hole, from 3 o'clock"], "L": ["HOLES", "Number of holes, evenly spaced"] } },
        "G71": { "name": "Bolt hole arc", "needsCycle": true, "need": [{ "of": ["I"], "count": 1 }, { "of": ["K"], "count": 1 }, { "of": ["L"], "count": 1 }],
                 "words": { "I": ["RAD", "Arc radius"], "J": ["STARTANG", "Angle of the first hole, from 3 o'clock"], "K": ["STEPANG", "Angle between holes (minus: clockwise)"], "L": ["HOLES", "Number of holes"] } },
        "G72": { "name": "Bolt holes along an angle", "needsCycle": true, "need": [{ "of": ["I"], "count": 1 }, { "of": ["L"], "count": 1 }],
                 "words": { "I": ["SPACING", "Distance between holes"], "J": ["ANGLE", "Angle of the line of holes, from 3 o'clock"], "L": ["HOLES", "Number of holes"] } },
        "G12": { "name": "Circular pocket, clockwise", "words": { "I": ["RAD1", "Radius of the first circle"], "K": ["RADFIN", "Finished radius"], "Q": ["STEP", "Step out each circle"], "D": ["DOFS", "Cutter comp offset"], "L": ["REPT", "Times round (G91: Z deeper each time)"] } },
        "G13": { "name": "Circular pocket, counterclockwise", "words": { "I": ["RAD1", "Radius of the first circle"], "K": ["RADFIN", "Finished radius"], "Q": ["STEP", "Step out each circle"], "D": ["DOFS", "Cutter comp offset"], "L": ["REPT", "Times round (G91: Z deeper each time)"] } },
        "G68": { "name": "Coordinate rotation", "words": { "A": ["CTRX", "Center of rotation, X"], "B": ["CTRY", "Center of rotation, Y"], "R": ["ANGLE", "Rotation angle, degrees"] } },
        "G101": { "name": "Mirror image on", "words": { "X": ["MIRX", "Mirror X about work zero"], "Y": ["MIRY", "Mirror Y about work zero"], "Z": ["MIRZ", "Mirror Z about work zero"], "A": ["MIRA", "Mirror A"] } },
        "G100": { "name": "Mirror image off", "words": { "X": ["MIRX", "X mirror off"], "Y": ["MIRY", "Y mirror off"], "Z": ["MIRZ", "Z mirror off"], "A": ["MIRA", "A mirror off"] } },
        "G107": { "name": "Cylindrical mapping", "words": { "A": ["AXIS", "The rotary axis (A0)"], "Y": ["WRAP", "The linear axis wrapped round it"], "Q": ["DIA", "Cylinder diameter (Q0: Setting 34)"], "R": ["RAD", "Rotary axis radius"] } }
      }
